# Copy to frontend/.env.local for local overrides. Placeholders only — never commit real values.
# Browser-side base path for API calls; /api is proxied to the agent by next.config.ts.
NEXT_PUBLIC_API_BASE=/api
# Server-side target of the /api proxy (FastAPI agent).
AGENT_URL=http://localhost:8000
# Neon Auth (production sign-in). Leave empty on the demo/judge deployment: the web app then shows the demo login.
# Auth URL of the Neon Auth instance (public, not a secret). Differs between dev and production.
NEON_AUTH_BASE_URL=
# Random string of at least 32 characters used to sign the session cookie on our domain (server-only secret).
NEON_AUTH_COOKIE_SECRET=
