# Copy to backend/.env (overrides the root .env). Placeholders only — never commit real values.
DATABASE_URL=
ALLOWED_ORIGINS=http://localhost:3000
ANTHROPIC_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=setu

# Sign-in. AUTH_MODE=demo (default): the open "login as" screen, judge deployment only.
# AUTH_MODE=neon: real accounts via Neon Auth (required when APP_ENV=prod).
AUTH_MODE=demo
# Neon Console > Branch > Auth > Configuration > Auth URL (https, ends in /neondb/auth). Public value.
NEON_AUTH_BASE_URL=
