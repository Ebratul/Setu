# Copy to backend/.env (overrides the root .env). Placeholders only — never commit real values.
DATABASE_URL=
ALLOWED_ORIGINS=http://localhost:3000
ANTHROPIC_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=setu

# Sign-in. AUTH_MODE=demo (default): the open "login as" screen, judge deployment only.
# AUTH_MODE=neon: real accounts via Neon Auth (required when APP_ENV=prod).
AUTH_MODE=demo
# Neon Console > Branch > Auth > Configuration > Auth URL (https, ends in /neondb/auth). Public value.
NEON_AUTH_BASE_URL=

# Approvals and step-up (AUTH_MODE=neon). Codes are emailed; with MAIL_PROVIDER=console nothing leaves the server.
# Prod needs OTP_SECRET_SEED, DOCUMENT_URL_SECRET, CRON_SECRET (each >= 32 random chars) and MAIL_PROVIDER=resend.
OTP_SECRET_SEED=
DOCUMENT_URL_SECRET=
CRON_SECRET=
MAIL_PROVIDER=console
MAIL_FROM=
MAIL_RESEND_API_KEY=
# Unset = on in neon mode, off in the demo. Prod refuses an explicit false.
# STEPUP_REQUIRED=
# FOUR_EYES_ENFORCE=

# P30 onboarding (names only; set real values in backend/.env or the host's secret store).
# DEMO_MODE=true: demo OTP inbox/echo and "auto-approve (demo)", and with AUTH_MODE=demo the demo login.
# With AUTH_MODE=neon the demo login and cookie stay OFF unless DEMO_COOKIE_IN_NEON=true (staging only).
# Set DEMO_MODE=false for any real deployment; APP_ENV=prod refuses true.
DEMO_MODE=true
# DEMO_COOKIE_IN_NEON=false
# Comma list of emails that become ADMIN on sign-up (they must then turn on TOTP). Case-insensitive.
ADMIN_EMAIL_ALLOWLIST=
# Comma list of invite codes that create JUDGE (read-only) accounts (each >= 16 chars). Treat like a password.
JUDGE_INVITE_CODES=
# Fernet key(s), comma list, newest first (python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())").
# Required when APP_ENV=prod; in dev a key is derived from DEMO_SESSION_SECRET with a warning.
FIELD_ENCRYPTION_KEY=
# HMAC secret for phone/dedupe blind indexes; falls back to OTP_SECRET_SEED.
PHONE_HASH_SECRET=
TERMS_VERSION=2026-10
# Unset = on in neon mode.
# GOOGLE_SIGNIN_ENABLED=
# console logs a masked number and sends nothing (dev only); webhook posts JSON to your SMS gateway
# (SMS_WEBHOOK_URL https, Authorization: Bearer SMS_WEBHOOK_TOKEN). APP_ENV=prod requires webhook.
SMS_PROVIDER=console
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
# Operator-tunable id formats (regex over the upper-cased value without spaces).
# BD_TRADE_LICENSE_REGEX=
# BD_IRC_REGEX=
# BD_TIN_REGEX=
