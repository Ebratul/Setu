# Copy to backend/.env (overrides the root .env). Placeholders only — never commit real values.
DATABASE_URL=
ALLOWED_ORIGINS=http://localhost:3000
ANTHROPIC_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=setu

# Sign-in. AUTH_MODE=demo (default): the open "login as" screen, judge deployment only.
# AUTH_MODE=neon: real accounts via Neon Auth (required when APP_ENV=prod).
AUTH_MODE=demo
# Neon Console > Branch > Auth > Configuration > Auth URL (https, ends in /neondb/auth). Public value.
NEON_AUTH_BASE_URL=

# Approvals and step-up (AUTH_MODE=neon). Codes are emailed; with MAIL_PROVIDER=console nothing leaves the server.
# Prod needs OTP_SECRET_SEED, DOCUMENT_URL_SECRET, CRON_SECRET (each >= 32 random chars) and MAIL_PROVIDER=resend.
OTP_SECRET_SEED=
DOCUMENT_URL_SECRET=
CRON_SECRET=
MAIL_PROVIDER=console
MAIL_FROM=
MAIL_RESEND_API_KEY=
# Unset = on in neon mode, off in the demo. Prod refuses an explicit false.
STEPUP_REQUIRED=
FOUR_EYES_ENFORCE=

# PayPal Sandbox checkout (simulated money only). Create a Sandbox REST app at developer.paypal.com.
# The API host is fixed to api-m.sandbox.paypal.com in code; live credentials are rejected by PayPal.
PAYPAL_SANDBOX_ENABLED=false
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
# Webhook id of the Sandbox app's webhook (event types PAYMENT.CAPTURE.COMPLETED / DENIED / REFUNDED).
PAYPAL_SANDBOX_WEBHOOK_ID=
