#!/usr/bin/env bash
# API smoke test of a running deployment. Usage:
#   BASE_URL=https://setu.example.com [AGENT_URL=https://api.example.com] scripts/smoke_prod
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
if command -v uv >/dev/null 2>&1; then
  exec uv run --directory "$root/backend" python "$root/scripts/smoke_prod.py" "$@"
fi
exec python3 "$root/scripts/smoke_prod.py" "$@"  # needs httpx installed
