# Local full-stack demo (docker compose --profile full). Harmless local placeholders only:
# nothing here is a real secret, and none of it may be reused for a deployment (see docs/deploy-prod.md).
#
#   docker compose --env-file docker-compose.env.example --profile full up --build
#   -> web http://localhost:3000   agent http://localhost:8000/health
#
# Copy to a git-ignored file (e.g. docker-compose.env.local) and edit to change ports or add an AI key.

# --- Postgres + pgvector (service `db`) ---
POSTGRES_USER=setu
POSTGRES_PASSWORD=setu-local-demo-only
POSTGRES_DB=setu
POSTGRES_PORT=5432

# --- Host ports (change them if 3000/8000/5432 are taken) ---
WEB_PORT=3000
AGENT_PORT=8000

# --- Demo + replay: no AI key needed, every AI answer comes from data/demo/fixtures ---
APP_ENV=dev
DEMO_MODE=true
DEMO_REPLAY=true
AGENT_MOCK_MODE=true
DEMO_COOLING_OFF_SECONDS=30
ALLOWED_ORIGINS=http://localhost:3000
DEMO_COOKIE_SECURE=false
# Optional: set a key and AGENT_MOCK_MODE=false to enable "Use live AI" in a sandbox.
ANTHROPIC_API_KEY=

# --- Local-only placeholders (cookie / OTP signing). Any 32+ character strings will do. ---
DEMO_SESSION_SECRET=local-demo-session-secret-not-a-real-secret
OTP_SECRET_SEED=local-demo-otp-seed-not-a-real-secret
# Empty: the seed creates a per-machine audit key in the `setu-keys` volume.
AUDIT_SIGNING_KEY=

# --- Edge protection (in-process; per agent process) ---
RATE_LIMIT_ENABLED=true
TRUSTED_PROXIES=

# --- Build identity shown by /health ---
GIT_SHA=local
BUILD_TIME=
