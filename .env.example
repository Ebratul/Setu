# Copy to .env at the repo root (cp .env.example .env) and fill in locally. Placeholders only — never commit real values.
# The agent reads this file, then services/agent/.env (which overrides it).

# --- Local Postgres + pgvector (docker compose) ---
POSTGRES_USER=setu
POSTGRES_PASSWORD=setu
POSTGRES_DB=setu
POSTGRES_PORT=5432

# --- Agent service ---
DATABASE_URL=postgresql+psycopg://setu:setu@localhost:5432/setu
ALLOWED_ORIGINS=http://localhost:3000

APP_ENV=dev
# Demo "login as" cookie signing; prod requires >= 32 chars and DEMO_COOKIE_SECURE=true.
DEMO_SESSION_SECRET=
DEMO_COOKIE_SECURE=false

# --- Models (Anthropic via app/llm/client.py only) ---
# Empty key or AGENT_MOCK_MODE=true -> deterministic offline mock model (dev, tests, demo).
ANTHROPIC_API_KEY=
AGENT_MOCK_MODE=false
MODEL_FAST=claude-haiku-5-5
MODEL_SMART=claude-sonnet-5-5
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
THREAD_TOKEN_BUDGET=60000
AGENT_MAX_TOOL_STEPS=6

# --- LangSmith tracing ---
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=setu

# --- Security (Phase 5.x): base64 Ed25519 seed and OTP seed ---
AUDIT_SIGNING_KEY=
OTP_SECRET_SEED=
DEMO_COOLING_OFF_SECONDS=600

# --- Web (see apps/web/.env.example) ---
NEXT_PUBLIC_API_BASE=/api
AGENT_URL=http://localhost:8000

# --- Demo data (seed) ---
# Anchor date for all demo dates (YYYY-MM-DD). After changing it run `pnpm run db:reset-demo`.
DEMO_TODAY=2026-10-20
