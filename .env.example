# Copy to .env at the repo root (cp .env.example .env) and fill in locally. Placeholders only — never commit real values.
# The agent reads this file, then services/agent/.env (which overrides it).

# --- Local Postgres + pgvector (docker compose) ---
POSTGRES_USER=setu
POSTGRES_PASSWORD=setu
POSTGRES_DB=setu
POSTGRES_PORT=5432

# --- Agent service ---
DATABASE_URL=postgresql+psycopg://setu:setu@localhost:5432/setu
ALLOWED_ORIGINS=http://localhost:3000

APP_ENV=dev
# Dev/test-only evidence override endpoint (POST /milestones/{id}/evidence). Never set in prod.
ENABLE_DEV_EVIDENCE=true
# Demo "login as" cookie signing; prod requires >= 32 chars and DEMO_COOKIE_SECURE=true.
DEMO_SESSION_SECRET=
DEMO_COOKIE_SECURE=false

# --- Models (Anthropic via app/llm/client.py only) ---
# Empty keys or AGENT_MOCK_MODE=true -> deterministic offline mock model (dev, tests, demo).
# LLM_PROVIDER=auto uses Anthropic if ANTHROPIC_API_KEY is set, else OpenRouter if OPENROUTER_API_KEY is set.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api
LLM_PROVIDER=auto
AGENT_MOCK_MODE=false
MODEL_FAST=claude-haiku-5-5
MODEL_SMART=claude-sonnet-5-5
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
THREAD_TOKEN_BUDGET=60000
AGENT_MAX_TOOL_STEPS=6

# --- Knowledge base (RAG): local multilingual embeddings, no paid API ---
KB_EMBEDDER=fastembed
KB_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# KB_MODEL_CACHE_DIR defaults to ~/.cache/setu-fastembed

# --- LangSmith tracing ---
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=setu

# --- Security (Phase 5.x): base64 Ed25519 seed and OTP seed ---
AUDIT_SIGNING_KEY=
OTP_SECRET_SEED=
DEMO_COOLING_OFF_SECONDS=600

# --- Web (see apps/web/.env.example) ---
NEXT_PUBLIC_API_BASE=/api
AGENT_URL=http://localhost:8000

# --- Demo data (seed) ---
# Anchor date for all demo dates (YYYY-MM-DD). After changing it run `pnpm run db:reset-demo`.
DEMO_TODAY=2026-10-20

# --- Guided demo and judge sandboxes (P21; docs/demo.md) ---
# DEMO_REPLAY=true serves every AI answer from data/demo/fixtures (identical every run, works offline).
# `pnpm demo:record` (needs an AI key) refreshes them; `pnpm demo:check` verifies them.
DEMO_REPLAY=false
SANDBOXES_ENABLED=true
SANDBOX_TTL_HOURS=4
SANDBOX_MAX_ACTIVE=40
SANDBOX_REQUESTS_PER_MINUTE=600
SANDBOX_CHAT_PER_MINUTE=12
SANDBOX_UPLOAD_PER_MINUTE=12
SANDBOX_CREATES_PER_HOUR_PER_IP=12
SANDBOX_LIVE_AI_BUDGET=25
# Bearer secret for POST /demo/cleanup (a scheduler drops expired sandboxes). Leave empty to disable.
CRON_SECRET=

# --- Document forensics (P14) ---
# Uploaded files go to STORAGE_DIR (git-ignored, never a public folder). Signed download links use
# DOCUMENT_URL_SECRET (falls back to DEMO_SESSION_SECRET).
# Keep <= 4 MB: Vercel functions reject request bodies over 4.5 MB.
DOCUMENT_MAX_BYTES=4194304
DOCUMENT_URL_TTL_SECONDS=300
DOCUMENT_URL_SECRET=
FORENSICS_LLM_EXTRACTION=true

# --- Edge protection and deploy identity (P23; docs/deploy-prod.md) ---
# In-process sliding windows: counted per agent process, so the ceiling is N x workers/instances.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=10
RATE_LIMIT_SANDBOX_CREATE_PER_MINUTE=5
RATE_LIMIT_GLOBAL_PER_MINUTE=300
# Comma list of proxy IPs/CIDRs whose X-Forwarded-For is believed ("*" = every peer; only behind a proxy).
TRUSTED_PROXIES=
# Largest non-upload request body (JSON etc.), bytes.
MAX_BODY_BYTES=1048576
# Shown by GET /health. The Docker build args / Vercel set these; both optional.
GIT_SHA=
BUILD_TIME=
