{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "frontend",
      "framework": "nextjs"
    },
    "agent": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "app/main.py",
      "rewrites": [{ "source": "/api/:path(.*)?", "destination": "/:path" }]
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "agent" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
